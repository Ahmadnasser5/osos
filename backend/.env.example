PORT=5000
JWT_SECRET=change_this_to_a_long_random_secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# Comma-separate multiple origins if you have prod + preview URLs on Vercel
FRONTEND_ORIGIN=http://localhost:5173
# Optional: point these at a mounted persistent disk in production
# (e.g. Render disk). Leave unset to use the default local folders.
# DB_DIR=/opt/render/project/src/backend/data
# UPLOAD_DIR=/opt/render/project/src/backend/data/uploads
